{
  "name": "@fiammybe/fluent2-bulma",
  "version": "0.0.0",
  "description": "The unofficial marriage between Bulma and Microsoft's Fluent2 design system",
  "license": "MIT",
  "author": "fiammybe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiammybe/fluent2-bulma.git"
  },
  "keywords": [
    "bulma",
    "fluent",
    "fluent2",
    "css",
    "sass",
    "theme"
  ],
  "sass": "sass/index.scss",
  "style": "css/fluent2-bulma.css",
  "main": "css/fluent2-bulma.css",
  "files": [
    "css",
    "js",
    "sass",
    "THIRD-PARTY-NOTICES"
  ],
  "exports": {
    ".": {
      "sass": "./sass/index.scss",
      "style": "./css/fluent2-bulma.css",
      "default": "./css/fluent2-bulma.css"
    },
    "./tokens": "./sass/tokens/_index.scss",
    "./tokens.css": "./css/fluent2-bulma.tokens.css",
    "./js": "./js/fluent2.mjs",
    "./css/*": "./css/*",
    "./sass/*": "./sass/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build-icons && npm run build-sass && npm run build-min && npm run build-js && npm run build-overview && npm run build-demo",
    "build-icons": "node scripts/build-icon-sprite.mjs",
    "build-sass": "vite build && sass --no-source-map sass/tokens-only.scss css/fluent2-bulma.tokens.css",
    "build-min": "vite build --mode minify && sass --style=compressed --no-source-map sass/tokens-only.scss css/fluent2-bulma.tokens.min.css",
    "build-js": "vite build --mode library && node -e \"const size=require('fs').statSync('js/fluent2.mjs').size;if(size>10240){console.error('JavaScript bundle exceeds 10 KiB');process.exitCode=1}\"",
    "build-overview": "vite build --mode overview",
    "build-demo": "vite build --mode demo",
    "test:e2e": "playwright test",
    "clean": "node -e \"for (const path of ['css','dist','js','public/fluent-icons.svg']) require('fs').rmSync(path,{recursive:true,force:true})\"",
    "dev": "npm run build && vite --open /overview.html",
    "dev:demo": "npm run build && vite --open /demo/index.html",
    "lint": "npm run lint:css && npm run format:check",
    "lint:css": "stylelint \"sass/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "bulma": "^1.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fluentui/svg-icons": "1.1.343",
    "@playwright/test": "^1.63.0",
    "bulma": "^1.0.4",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
